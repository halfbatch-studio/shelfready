{
  "name": "shelfready",
  "version": "0.3.0",
  "description": "Get an iOS app ready for the App Store: legal pages, App Privacy answers, privacy manifests and a go-live checklist. CLI and MCP server for coding agents.",
  "type": "module",
  "bin": {
    "shelf": "dist/cli.js",
    "shelfready": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "knowledge/sdks",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "kb:import": "tsx scripts/kb-import.ts",
    "prepack": "npm run build && cp ../README.md ../LICENSE ../NOTICE .",
    "postpack": "rm -f README.md LICENSE NOTICE",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^15.1.0",
    "plist": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "author": "Half Batch <hello@shelfready.dev>",
  "homepage": "https://shelfready.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halfbatch-studio/shelfready.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/halfbatch-studio/shelfready/issues",
  "keywords": [
    "ios",
    "app-store",
    "privacy-policy",
    "privacy-manifest",
    "impressum",
    "gdpr",
    "app-privacy",
    "cli",
    "fastlane",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "ai-agents",
    "swift",
    "xcode",
    "app-store-connect"
  ],
  "mcpName": "io.github.halfbatch-studio/shelfready"
}
