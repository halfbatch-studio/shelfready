// shelfready.dev: static pages plus one API route (/api/check, the App Store listing check) in worker.mjs.
// Deployed by Cloudflare Workers Builds with `npx wrangler deploy` from this folder after the build.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "shelfready",
  "compatibility_date": "2026-06-01",
  "main": "worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs the Worker; every other request is served straight from ./dist.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "shelfready.dev", "custom_domain": true }],
  // Pull requests get a preview with its own URL; production stays on shelfready.dev and workers.dev stays off.
  "previews": {},
  "preview_urls": true
}
